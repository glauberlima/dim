root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# 2-space files: manifest, resource script, SVG, TOML, YAML (GitHub workflows).
[*.{toml,yml,yaml,manifest,rc,svg}]
indent_size = 2

[Cargo.lock]
end_of_line = lf
